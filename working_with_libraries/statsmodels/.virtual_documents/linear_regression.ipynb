import pandas as pd
import statsmodels.formula.api as smf

df = pd.read_csv("storks_vs_birth_rate.csv").set_axis(["Y", "X"], axis=1)
results = smf.ols("Y ~ X", data=df).fit()
print(results.summary())





slope = results.params["X"]
y_0 = results.params["Intercept"]
r_square = results.rsquared
p_value = results.pvalues["X"]








fig, ax = plt.subplots(layout="constrained")
ax.scatter(results.fittedvalues, results.resid)
ax.axhline(0, color="C1", linestyle="--")
ax.set(xlabel="Fitted Values", ylabel="Residuals", title="Residuals vs. Fitted")
plt.show()








import statsmodels.api as sm

fig, ax = plt.subplots(layout="constrained")
sm.qqplot(results.resid, ax=ax, line="s")
fig.savefig("qqplot.png")
plt.show()











from scipy.stats import shapiro

stat, p = shapiro(results.resid)
print(f"Shapiro-Wilk Test: W = {stat:.3f}, p = {p:.3f}")

if p > 0.05:
    print("Fail to reject normality (residuals are consistent with a normal distribution)")
else:
    print("Reject normality (residuals deviate significantly from a normal distribution)")

















pred = results.get_prediction(df).summary_frame(alpha=0.05)

# pred["mean"]          -> fitted values
# pred["mean_ci_lower"] -> lower bound of 95% confidence interval (mean)
# pred["mean_ci_upper"] -> upper bound of 95% confidence interval (mean)
# pred["obs_ci_lower"]  -> lower bound of 95% prediction interval (new obs)
# pred["obs_ci_upper"]  -> upper bound of 95% prediction interval (new obs)








ax.fill_between(df["X"], pred["mean_ci_lower"], pred["mean_ci_upper"], alpha=0.25, color="C1")











import matplotlib.pyplot as plt
import pandas as pd
import statsmodels.formula.api as smf

# Load, rename, drop missing values, and sort by X for clean band plotting
df = (
    pd.read_csv("storks_vs_birth_rate.csv")
    .set_axis(["Y", "X"], axis=1)
    .dropna()
    .sort_values("X")
)

# Fit OLS model and compute 95% confidence & prediction intervals
results = smf.ols("Y ~ X", data=df).fit()
pred = results.get_prediction(df).summary_frame(alpha=0.05)

# Plot
plt.style.use("ggplot")
fig, ax = plt.subplots(dpi=120, layout="constrained")

# add confidence bands
ax.fill_between(df["X"], pred["obs_ci_lower"], pred["obs_ci_upper"], alpha=0.12, color="C1", label="95% Prediction Interval")
ax.fill_between(df["X"], pred["mean_ci_lower"], pred["mean_ci_upper"], alpha=0.25, color="C1", label="95% Confidence Interval")
# plot regression line
ax.plot(df["X"], pred["mean"], color="C1", label="OLS Fit")
# plot data
ax.scatter(df["X"], df["Y"], color="C0", label="Data")

# add regression paramters
summary_text = (
    f"y = {results.params['Intercept']:.2f} + {results.params['X']:.4f}x\n"
    f"$R^2$ = {results.rsquared:.2f}\n"
    f"p = {results.pvalues['X']:.4f}"
)
ax.text(0.05, 0.95, summary_text, transform=ax.transAxes, va="top")
ax.set(xlabel="Stork Pairs", ylabel=r"Newborn Babies [$10^3$]")
ax.legend(loc="lower right")
fig.savefig("stork_new.png")
plt.show()






